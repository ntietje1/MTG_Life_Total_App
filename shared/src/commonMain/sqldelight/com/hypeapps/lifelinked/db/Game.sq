import kotlin.Boolean;

CREATE TABLE game (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    num_players INTEGER NOT NULL DEFAULT 4,
    alt_player_layout INTEGER AS Boolean NOT NULL DEFAULT 0,
    start_timestamp INTEGER NOT NULL DEFAULT CURRENT_TIMESTAMP,
    end_timestamp INTEGER DEFAULT NULL,
    first_player_num INTEGER DEFAULT NULL,
    turn_timer_enabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    monarchy_player_num INTEGER DEFAULT NULL,
    winner_player_num INTEGER DEFAULT NULL,
    day_night_state TEXT DEFAULT 'NONE',
    FOREIGN KEY (winner_player_num) REFERENCES player(player_num),
    FOREIGN KEY (monarchy_player_num) REFERENCES player(player_num),
    FOREIGN KEY (first_player_num) REFERENCES player(player_num)
);

getGameWithPlayers:
SELECT 
    g.*,
    p.*
FROM game g
JOIN player p ON g.id = p.game_id
WHERE g.id = ? AND p.game_id = g.id
GROUP BY p.player_num
ORDER BY p.player_num;

insertGame:
INSERT INTO game (num_players)
VALUES (?);

updateGame:
UPDATE game 
SET num_players = ?,
    alt_player_layout = ?,
    end_timestamp = ?,
    first_player_num = ?,
    turn_timer_enabled = ?,
    monarchy_player_num = ?,
    winner_player_num = ?,
    day_night_state = ?
WHERE id = ?;

updateMonarchy:
UPDATE game
SET monarchy_player_num = :monarchy_player_num
WHERE id = :game_id;

lastInsertRowId:
SELECT last_insert_rowid();