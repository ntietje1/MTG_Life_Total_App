CREATE TABLE game (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    num_players INTEGER NOT NULL DEFAULT 4,
    altPlayerLayout INTEGER NOT NULL DEFAULT 0,
    start_timestamp INTEGER NOT NULL DEFAULT CURRENT_TIMESTAMP,
    end_timestamp INTEGER DEFAULT NULL,
    winner_pid INTEGER DEFAULT NULL,
    monarch_pid INTEGER DEFAULT NULL,
    day_night INTEGER NOT NULL DEFAULT 0,
    player_select_seen INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (monarch_pid) REFERENCES player(id),
    FOREIGN KEY (winner_pid) REFERENCES player(id)
);

getGameWithPlayers:
SELECT 
    g.*,
    p.id AS player_id,
    p.name,
    p.image_string,
    p.color,
    p.text_color,
    p.player_num,
    p.life_total,
    p.life_total_recent_change,
    p.set_dead,
    p.partner_mode,
    GROUP_CONCAT(cd.damage || ',' || cd.recent_change) AS commander_damages,
    GROUP_CONCAT(c.value) AS counters
FROM game g
JOIN player p ON g.id = p.game_id
LEFT JOIN commander_damage cd ON p.id = cd.reciever_player_id
LEFT JOIN counter c ON p.id = c.player_id
WHERE g.id = ?
GROUP BY p.id
ORDER BY p.player_num;

insertGame:
INSERT INTO game (num_players)
VALUES (?);

updateGameMonarch:
UPDATE game
SET monarch_pid = ?
WHERE id = ?;

updateGameDayNight:
UPDATE game
SET day_night = ?
WHERE id = ?;

updateGameAltPlayerLayout:
UPDATE game
SET altPlayerLayout = ?
WHERE id = ?;

updateGameNumPlayers:
UPDATE game
SET num_players = ?
WHERE id = ?;

updatePlayerSelectSeen:
UPDATE game
SET player_select_seen = ?
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();