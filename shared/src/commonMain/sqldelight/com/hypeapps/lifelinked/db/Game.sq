CREATE TABLE game (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    num_players INTEGER NOT NULL DEFAULT 4,
    start_timestamp INTEGER NOT NULL DEFAULT CURRENT_TIMESTAMP,
    end_timestamp INTEGER DEFAULT NULL,
    winner_player_num INTEGER DEFAULT NULL,
    FOREIGN KEY (winner_player_num) REFERENCES player(player_num)
);

getGameWithPlayers:
SELECT 
    g.*,
    p.*
FROM game g
JOIN player p ON g.id = p.game_id
WHERE g.id = ? AND p.game_id = g.id
GROUP BY p.player_num
ORDER BY p.player_num;

getCommanderDamages:
SELECT
    receiver_player_num,
    damage
FROM commander_damage
WHERE game_id = ?;

getCounters:
SELECT 
    player_num,
    counter_value
FROM counter
WHERE game_id = ?;

insertGame:
INSERT INTO game (num_players)
VALUES (?);

updateGame:
UPDATE game 
SET num_players = ?, 
    end_timestamp = ?, 
    winner_player_num = ?
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();