import kotlin.Boolean;

CREATE TABLE player (
    game_id INTEGER NOT NULL,
    player_num INTEGER NOT NULL,
    name TEXT NOT NULL,
    image_string TEXT,
    color INTEGER NOT NULL,
    text_color INTEGER NOT NULL,
    life_total INTEGER NOT NULL,
    monarch INTEGER AS Boolean NOT NULL DEFAULT 0,
    set_dead INTEGER AS Boolean NOT NULL DEFAULT 0,
    partner_mode INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY (game_id) REFERENCES game(id),
    PRIMARY KEY (game_id, player_num)
);

CREATE TABLE commander_damage (
    game_id INTEGER NOT NULL,
    receiver_player_num INTEGER NOT NULL,
    dealer_player_num INTEGER NOT NULL,
    damage INTEGER NOT NULL,
    FOREIGN KEY (receiver_player_num) REFERENCES player(player_num),
    FOREIGN KEY (dealer_player_num) REFERENCES player(player_num),
    PRIMARY KEY (game_id, receiver_player_num, dealer_player_num)
);

CREATE TABLE counter (
    game_id INTEGER NOT NULL,
    player_num INTEGER NOT NULL,
    counter_type INTEGER NOT NULL,
    counter_value INTEGER NOT NULL,
    FOREIGN KEY (player_num) REFERENCES player(player_num),
    PRIMARY KEY (game_id, player_num, counter_type)
);

-- Queries
insertPlayer:
INSERT INTO player (
    game_id, player_num, name, image_string, color, text_color,
    life_total, monarch, set_dead, partner_mode
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updatePlayer:
UPDATE player SET
    name = ?,
    image_string = ?,
    color = ?,
    text_color = ?,
    life_total = ?,
    monarch = ?,
    set_dead = ?,
    partner_mode = ?
WHERE game_id = ? AND player_num = ?;


insertCommanderDamage:
INSERT INTO commander_damage (game_id, receiver_player_num, dealer_player_num, damage)
VALUES (?, ?, ?, ?);

updateCommanderDamage:
UPDATE commander_damage SET
    damage = ?
WHERE game_id = ? AND receiver_player_num = ? AND dealer_player_num = ?;

insertCounter:
INSERT INTO counter (game_id, player_num, counter_type, counter_value)
VALUES (?, ?, ?, ?);

updateCounter:
UPDATE counter SET
    counter_value = ?
WHERE game_id = ? AND player_num = ? AND counter_type = ?;

deleteAllPlayers:
DELETE FROM player;

lastInsertRowId:
SELECT last_insert_rowid();
